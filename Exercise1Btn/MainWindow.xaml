<Window x:Class="WpfTutorial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfTutorial"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Up left" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Red" />
        <Button Content="Up right" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="Green"/>
        <Button Content="Buttom Right" Click="Button_Click_1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="HotPink"/>
        <Button Content="Down left" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="Blue"/>

    </Grid>
</Window>
