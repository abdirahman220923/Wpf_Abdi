<Window x:Class="AbdiExe1LAYOUTS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AbdiExe1LAYOUTS"
        mc:Ignorable="d"
        Title="MA SUPER" Height="450" Width="800">
    <Grid Background="#FF7A7A7A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="txtAffichage"
                 Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                 Margin="10,10,5,10"
                 Background="White"
                 FontSize="20" />

        <Button x:Name="btnClear"
                Grid.Row="0" Grid.Column="3"
                Margin="5,10,10,10"
                Background="Red"
                FontSize="18"
                FontWeight="Bold"
                Content="C" />

        <Button x:Name="btn1" Grid.Row="1" Grid.Column="0"
                Margin="10" Background="#FF7FCDCD" FontSize="18" Content="1" />
        <Button x:Name="btn2" Grid.Row="1" Grid.Column="1"
                Margin="10" Background="#FF7FCDCD" FontSize="18" Content="2" />
        <Button x:Name="btn3" Grid.Row="1" Grid.Column="2"
                Margin="10" Background="#FF7FCDCD" FontSize="18" Content="3" />
        <Button x:Name="btnPlus" Grid.Row="1" Grid.Column="3"
                Margin="10" Background="#FF5CB85C" FontSize="18" Content="+" />

        <Button x:Name="btn4" Grid.Row="2" Grid.Column="0"
                Margin="10" Background="#FF7FCDCD" FontSize="18" Content="4" />
        <Button x:Name="btn5" Grid.Row="2" Grid.Column="1"
                Margin="10" Background="#FF7FCDCD" FontSize="18" Content="5" />
        <Button x:Name="btn6" Grid.Row="2" Grid.Column="2"
                Margin="10" Background="#FF7FCDCD" FontSize="18" Content="6" />
        <Button x:Name="btnMoins" Grid.Row="2" Grid.Column="3"
                Margin="10" Background="#FF5CB85C" FontSize="18" Content="-" />

        <Button x:Name="btn7" Grid.Row="3" Grid.Column="0"
                Margin="10" Background="#FF7FCDCD" FontSize="18" Content="7" />
        <Button x:Name="btn8" Grid.Row="3" Grid.Column="1"
                Margin="10" Background="#FF7FCDCD" FontSize="18" Content="8" />
        <Button x:Name="btn9" Grid.Row="3" Grid.Column="2"
                Margin="10" Background="#FF7FCDCD" FontSize="18" Content="9" />
        <Button x:Name="btnDiv" Grid.Row="3" Grid.Column="3"
                Margin="10" Background="#FF5CB85C" FontSize="18" Content="/" />

        <Button x:Name="btnVirgule" Grid.Row="4" Grid.Column="0"
                Margin="10" Background="#FF9BD3F0" FontSize="18" Content="," />
        <Button x:Name="btn0" Grid.Row="4" Grid.Column="1"
                Margin="10" Background="#FF7FCDCD" FontSize="18" Content="0" />
        <Button x:Name="btnFois" Grid.Row="4" Grid.Column="2"
                Margin="10" Background="#FF5CB85C" FontSize="18" Content="*" />
        <Button x:Name="btnEgal" Grid.Row="4" Grid.Column="3"
                Margin="10" Background="#FFF0C419" FontSize="18" Content="=" />
    </Grid>
</Window>
