<Window x:Class="AbdiLayouts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AbdiLayouts"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FFF5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Background="#FFE8E8E8">
            <Button x:Name="btnHG1" Content="Bouton 1" Height="100" Margin="6" />
            <Button x:Name="btnHG2" Content="Bouton 2" Height="100" Margin="6" />
        </StackPanel>

        <DockPanel Grid.Row="0" Grid.Column="1" Background="#FFDCDCDC" LastChildFill="True">
            <Button x:Name="btnDockTop"    DockPanel.Dock="Top"    Content="Top"       Height="45" />
            <Button x:Name="btnDockBottom" DockPanel.Dock="Bottom" Content="Bottom"    Height="45" />
            <Button x:Name="btnDockLeft"   DockPanel.Dock="Left"   Content="Left"      Width="55" />
            <Button x:Name="btnDockRight"  DockPanel.Dock="Right"  Content="Right"     Width="55" />
            <Button x:Name="btnDockCenter" Content="Direction" />
        </DockPanel>

        <WrapPanel Grid.Row="1" Grid.Column="0"
               Background="#FFD0D0D0"
               Width="270"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               ItemWidth="90"
               ItemHeight="60">
            <Button x:Name="btnWrap1" Content="Bouton 1" />
            <Button x:Name="btnWrap2" Content="Bouton 2" />
            <Button x:Name="btnWrap3" Content="Bouton 3" />
            <Button x:Name="btnWrap4" Content="Bouton 4" />
            <Button x:Name="btnWrap5" Content="Bouton 5" />
            <Button x:Name="btnWrap6" Content="Bouton 6" />
        </WrapPanel>

        <Canvas Grid.Row="1" Grid.Column="1" Background="#FFEDEDED">
            <Ellipse x:Name="cibleNoire"
                 Width="150" Height="150"
                 Fill="Black"
                 Canvas.Left="65" Canvas.Top="55" />
            <Ellipse x:Name="cibleJaune"
                 Width="100" Height="100"
                 Fill="Yellow"
                 Canvas.Left="90" Canvas.Top="80" />
            <Ellipse x:Name="cibleRouge"
                 Width="50" Height="50"
                 Fill="Red"
                 Canvas.Left="115" Canvas.Top="105" />
        </Canvas>
    </Grid>
</Window>
